# Copy to ~/.env.cloud-coco and fill in values
# chmod 600 ~/.env.cloud-coco

# Anthropic API key
CLAUDE_API_KEY=

# 64 hex chars — generated by bootstrap.sh (openssl rand -hex 32)
# Must match the CONTEXT_PACK_KEY secret in GCP Secret Manager
CONTEXT_PACK_KEY=

# GCS bucket name, e.g. cloud-coco-memory-abc123
GCS_BUCKET=
